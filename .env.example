# =============================================================================
# SokoHub Marketplace - Environment Variables Template
# Copy this file to .env and provide your specific credentials.
# Do NOT commit .env to version control (already protected in .gitignore).
# =============================================================================

# Database Configuration (Optional override for Docker / Remote DB)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=sokohub_db
# DB_USER=root
# DB_PASS=

# M-Pesa Daraja 2.0 Credentials (Safaricom Developer Portal)
MPESA_ENV=sandbox            # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=             # Daraja business shortcode used for STK Push
MPESA_TILL_NUMBER=1648753    # platform Till that receives all customer payments
MPESA_CALLBACK_URL=          # public HTTPS URL for STK callback
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_RESULT_URL=
MPESA_TIMEOUT_URL=
PLATFORM_FEE_PERCENT=2

# STK Push Configuration
# MPESA_TRANSACTION_TYPE: CustomerBuyGoodsOnline (for Till 1648753) or CustomerPayBillOnline
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# Settlement & Payout Rules
# MPESA_PAYOUT_TRIGGER: on_delivery (default, safe) | on_payment
MPESA_PAYOUT_TRIGGER=on_delivery

# MPESA_DELIVERY_PAYOUT_TRIGGER: automatic (default on delivery) | manual
MPESA_DELIVERY_PAYOUT_TRIGGER=automatic

# Local Development Simulation (Set to false when live ngrok tunnel & Daraja keys are connected)
MPESA_ALLOW_SIMULATION=true
