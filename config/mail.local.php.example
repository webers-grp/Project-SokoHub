<?php
/**
 * SokoHub Outbound SMTP Email Configuration Template
 *
 * HOW TO SEND REAL VERIFICATION CODES TO EMAIL:
 * 1. Copy this file to `config/mail.local.php`:
 *    cp config/mail.local.php.example config/mail.local.php
 *
 * 2. If using Gmail (Free, instant setup, 500 emails/day):
 *    a) Log in to your Google Account at https://myaccount.google.com/
 *    b) Enable 2-Step Verification (Security tab)
 *    c) Go to https://myaccount.google.com/apppasswords
 *    d) Create an app named "SokoHub" and copy the 16-character password (e.g. abcd efgh ijkl mnop)
 *    e) Paste your Gmail and App Password below.
 *
 * 3. `config/mail.local.php` is ignored by Git to protect your password.
 */

return [
    // Outbound SMTP host (Gmail: smtp.gmail.com, Brevo: smtp-relay.brevo.com, Outlook: smtp.office365.com)
    'host'         => 'smtp.gmail.com',

    // Port: 587 (TLS/STARTTLS) or 465 (SSL)
    'port'         => 587,

    // Encryption: 'tls' for port 587, 'ssl' for port 465
    'encryption'   => 'tls',

    // Your SMTP email address
    'user'         => 'your-email@gmail.com',

    // 16-character Google App Password (or SMTP password)
    'pass'         => 'xxxx xxxx xxxx xxxx',

    // Sender email address displayed to recipients
    'from'         => 'your-email@gmail.com',

    // Sender display name
    'name'         => 'SokoHub Verification',

    // Set to false to hide on-screen simulation codes and autofill buttons
    'show_dev_otp' => false,
];
