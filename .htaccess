# SokoHub Apache / InfinityFree / XAMPP Security Rules
Options -Indexes

# Protect sensitive config, database SQL scripts, and test scripts from direct HTTP access
<FilesMatch "\.(sql|md|log|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|database|includes|tests|docs)/ - [F,L]
</IfModule>
